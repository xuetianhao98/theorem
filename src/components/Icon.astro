---
interface Props { name: string; width?: number; height?: number; class?: string; label?: string }
const { name, width = 120, height = 80, class: cls = '', label } = Astro.props;
const viewBox = ['i-mark', 'i-tip', 'i-warn'].includes(name) ? '0 0 48 32' : '0 0 120 80';
---
<svg class={`icon ${cls}`} width={width} height={height} viewBox={viewBox}
  role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <use href={`#${name}`} />
</svg>
