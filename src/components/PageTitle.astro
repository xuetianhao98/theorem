---
interface Props { title: string; sub?: string }
const { title, sub } = Astro.props;
---
<header class="pt">
  <h1>{title}</h1>
  {sub && <p>{sub}</p>}
</header>
<style>
  .pt { margin-bottom: 28px; display: grid; gap: 8px; }
  h1 { font-size: clamp(24px, 3.4vw, 32px); line-height: 1.4; }
  p { color: var(--muted-text); font-size: 14px; }
</style>
