---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="找不到这一页">
  <section class="lost">
    <Icon name="i-lost" width={180} height={120} />
    <h1>这条路好像断了。</h1>
    <p>你要找的页面不存在，或者已经搬走了。</p>
    <p><a href="/">回到首页 →</a></p>
  </section>
</Base>
<style>
  .lost { display: grid; gap: 12px; justify-items: start; padding: 24px 0; }
  .lost :global(svg) { color: var(--ink); margin-bottom: 16px; }
  h1 { font-size: clamp(24px, 3.6vw, 32px); }
  p { color: var(--muted-text); }
  a { color: var(--accent-text); }
</style>
