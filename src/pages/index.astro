---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import YearGroups from '../components/YearGroups.astro';
import { getPosts } from '../lib/site';
const all = await getPosts();
const posts = all.slice(0, 15);
---
<Base>
  <section class="hello">
    <h1>写代码的时候想明白的事，和路上看到的风景，都<span class="hl">记在这里</span>。</h1>
    <Icon name="i-hill" class="draw" />
  </section>
  <YearGroups posts={posts} />
  {all.length > posts.length && <p class="more"><a href="/posts/">全部文章 →</a></p>}
</Base>
<style>
  .hello { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px 40px; align-items: center; margin-bottom: clamp(40px, 7vw, 80px); }
  h1 { font-weight: 500; font-size: clamp(24px, 3.6vw, 36px); line-height: 1.45; max-width: 18em; }
  .hello :global(.draw) { width: clamp(150px, 22vw, 220px); height: auto; color: var(--ink); }
  @media (max-width: 820px) { .hello { grid-template-columns: 1fr; } }
  .more { font-size: 14px; color: var(--accent-text); }
</style>
