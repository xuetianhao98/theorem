{
  // Cloudflare Workers 静态资源托管：只发 dist/ 里的文件，没有服务端代码。
  "name": "theorem",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  },
  "routes": [
    { "pattern": "xuethlovelicy.xyz", "custom_domain": true },
    { "pattern": "www.xuethlovelicy.xyz", "custom_domain": true }
  ]
}
